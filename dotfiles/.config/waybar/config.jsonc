{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "pulseaudio", "cpu", "memory", "network", "custom/power"],

    "hyprland/workspaces": {
        "format": "{name}"
    },

    "clock": {
        "format": "{:%H:%M   %d/%m/%Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": "󰍛 {usage}%"
    },

    "memory": {
        "format": "󰘚 {percentage}%"
    },

    "network": {
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-wifi": "{icon} {essid}",
        "format-ethernet": "󰀂",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "Connecté ({ipaddr}/{cidr})",
        "tooltip-format-disconnected": "Déconnecté"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 0%",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "tray": {
        "spacing": 8
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": true,
        "tooltip-format": "Clic gauche : éteindre\nClic droit : redémarrer\nClic molette : fermer la session",
        "on-click": "systemctl poweroff",
        "on-click-right": "systemctl reboot",
        "on-click-middle": "hyprctl dispatch 'hl.dsp.exit()'"
    }
}
