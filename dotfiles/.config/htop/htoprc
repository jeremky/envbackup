# Config file for htop

# Hide userland threads.
hide_userland_threads=1

# Shadow processes of other users.
shadow_other_users=1

# Hide screen tabs.
screen_tabs=0

# Header meters.
column_meters_0=CPU Memory DiskIO
column_meter_modes_0=1 1 2
column_meters_1=Tasks LoadAverage Uptime
column_meter_modes_1=2 2 2

# Process screens.
screen:Main=PID USER PERCENT_CPU PERCENT_MEM TIME Command
.sort_key=PERCENT_CPU
.sort_direction=-1
screen:I/O=PID USER IO_RATE IO_READ_RATE IO_WRITE_RATE Command
.sort_key=IO_RATE
.sort_direction=-1
