// ─── Zed keymap ─────────────────────────────────────────────────────────

[
  {
    "context": "Editor",
    "bindings": {
      "f2": "workspace::ToggleVimMode",
      "f3": "editor::SelectAllMatches",
      "f4": "editor::ToggleComments",
      "f5": "editor::Format",
    },
  },
  {
    "bindings": {
      "f1": "command_palette::Toggle",
      "alt-shift-a": "workspace::ToggleZoom",
      "alt-shift-e": "project_panel::ToggleFocus",
      "alt-shift-g": "git_panel::ToggleFocus",
      "alt-shift-c": "multi_workspace::ToggleWorkspaceSidebar",
      "alt-shift-x": "zed::Extensions",
    },
  },
]
