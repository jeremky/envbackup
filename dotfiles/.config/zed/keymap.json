// ─── Zed keymap ─────────────────────────────────────────────────────────

[
  {
    "context": "Editor",
    "bindings": {
      "f2": "workspace::ToggleVimMode",
      "f3": "editor::SelectAllMatches",
      "f4": "editor::ToggleComments",
      "f5": "editor::Format",
    },
  },
  {
    "bindings": {
      "f1": "command_palette::Toggle",
      "alt-b": "workspace::ToggleLeftDock",
      "alt-r": "workspace::ToggleRightDock",
      "alt-a": "workspace::ToggleZoom",
      "alt-e": "project_panel::ToggleFocus",
      "alt-g": "git_panel::ToggleFocus",
      "alt-c": "multi_workspace::ToggleWorkspaceSidebar",
    },
  },
]
