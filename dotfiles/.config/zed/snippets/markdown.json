{
  "Bash block": {
    "prefix": "bash",
    "body": ["```bash", "${1:}", "```", ""],
    "description": "Bash block"
  },

  "Code block": {
    "prefix": "code",
    "body": ["```${1:code}", "${2:}", "```", ""],
    "description": "Text block"
  },

  "Image block": {
    "prefix": "img",
    "body": ["![${1:alt}](${1:}.webp)"],
    "description": "Image block"
  },

  "Info block": {
    "prefix": "info",
    "body": ["> [!${1:IMPORTANT}]", "> ${2:}", ""],
    "description": "Info block"
  },

  "URL block": {
    "prefix": "url",
    "body": ["[${1:text}](${2:})", ""],
    "description": "URL block"
  },

  "Hugo code block": {
    "prefix": "hugo codefile",
    "body": ["```${1:code} {filename=\"${2:file}\"}", "${3:}", "```", ""],
    "description": "File block in Hugo"
  },

  "Card Hugo": {
    "prefix": "hugo card",
    "body": [
      "{{< card link=\"${1:}\" title=\"${1:}\" icon=\"${2:document}\" >}}"
    ],
    "description": "Card block for a Hugo blog"
  },

  "Videos Hugo": {
    "prefix": "hugo video",
    "body": ["{{< youtube ${1:shorturl} >}}", ""],
    "description": "Video block for a Hugo blog"
  }
}
