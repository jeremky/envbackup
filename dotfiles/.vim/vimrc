" ─── vimrc ───────────────────────────────────────────────────────────────

silent! set nocompatible        " No Vi compatibility
silent! set ttimeout            " Time out on key codes
silent! set ttimeoutlen=50      " No noticeable Esc delay

" Indentation & tabs
silent! set autoindent          " Keep indentation on new line
silent! set smarttab            " Smart leading whitespace
silent! set tabstop=2           " Tab width
silent! set shiftwidth=2        " Indent width
silent! set softtabstop=2       " Columns per Tab keypress
silent! set expandtab           " Tabs become spaces

" Search
silent! set hlsearch            " Highlight matches
silent! set incsearch           " Search while typing
silent! set ignorecase          " Ignore case...
silent! set smartcase           " ...unless an uppercase letter is typed

" Interface
silent! set ruler               " Show cursor position
silent! set showcmd             " Show pending command
silent! set showmatch           " Flash matching bracket

" Buffers & navigation
silent! set hidden              " Allow hidden modified buffers
silent! set scrolloff=8         " Context lines around cursor
silent! set splitbelow          " Horizontal splits go below
silent! set splitright          " Vertical splits go right

" Misc
silent! set mouse=              " Mouse off by default
silent! set nobackup            " No backup files
silent! set noswapfile          " No swap files

" Basic mappings
nnoremap <S-Tab> <C-w>w
nnoremap <silent> <CR> :nohlsearch<CR><CR>

" ─── full Vim only (skipped by vim.tiny) ─────────────────────────────────
if 1

  " Syntax & filetypes
  " syntax on
  " filetype plugin indent on

  " Display
  silent! set linebreak         " Wrap at word boundaries
  silent! set breakindent       " Wrapped lines keep indentation
  silent! set background=dark   " Dark terminal
  silent! set wildmenu          " Command-line completion menu
  silent! set wildoptions=pum   " Vertical completion popup (Vim 8.2.4325+)
  silent! set spelllang=en,fr   " Spell checking languages

  " Invisible characters (shown with F3)
  let &listchars = "eol:$,space:\u00B7,tab:\u25B8\ ,trail:\u00B7"

  " Cursor shape per mode (insert, normal, replace)
  let &t_SI = "\e[6 q"
  let &t_EI = "\e[2 q"
  let &t_SR = "\e[4 q"
  let &t_te .= "\e[0 q"

  " ─── functions ─────────────────────────────────────────────────────────

  " Toggle line numbers and mouse in all windows
  function! ModeIDE()
    let g:modeIDE_enabled = !get(g:, 'modeIDE_enabled', 0)
    let &mouse = g:modeIDE_enabled ? 'a' : ''
    let l:win = win_getid()
    windo let &l:number = g:modeIDE_enabled
    call win_gotoid(l:win)
    echo 'IDE mode ' . (g:modeIDE_enabled ? 'enabled' : 'disabled')
  endfunction

  " Reindent the whole file, keep cursor position
  function! ReindentFile()
    let l:view = winsaveview()
    normal! gg=G
    call winrestview(l:view)
  endfunction

  " ─── mappings ──────────────────────────────────────────────────────────

  " Spell checker
  nnoremap <F1> <Cmd>set spell!<CR>

  " IDE Mode
  nnoremap <F2> <Cmd>call ModeIDE()<CR>

  " Show invisible characters
  nnoremap <F3> :set list!<CR>

  " Commentary
  nmap <F4> gcc
  xmap <F4> gc

  " Automatic indentation
  nnoremap <F5> <Cmd>call ReindentFile()<CR>

  " Manage plugins
  nnoremap <F7> <Cmd>PlugClean<CR>
  nnoremap <F8> <Cmd>PlugUpdate<CR>

  " ─── plugins (vim-plug) ────────────────────────────────────────────────

  " Download vim-plug if missing
  if empty(glob('~/.vim/autoload/plug.vim'))
    silent !curl -fLo ~/.vim/autoload/plug.vim --create-dirs
          \ https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
  endif

  " Install missing plugins at startup, then reload
  autocmd VimEnter *
        \ if len(filter(values(g:plugs), '!isdirectory(v:val.dir)'))
        \|  PlugInstall --sync | source $MYVIMRC
        \| endif

  call plug#begin('~/.vim/plugged')

  Plug 'catppuccin/vim', { 'as': 'catppuccin' }
  Plug 'itchyny/lightline.vim'
  Plug 'vim-scripts/VimCompletesMe'

  " Built-in commentary plugin on Vim 9.1+, vim-commentary otherwise
  try | packadd! comment | catch | Plug 'tpope/vim-commentary' | endtry

  call plug#end()

  " ─── autocmds ──────────────────────────────────────────────────────────

  augroup vimrc
    autocmd!

    " Restore last cursor position
    autocmd BufReadPost *
          \ if (line("'\"") > 1) && (line("'\"") <= line("$"))
          \ |   silent exe "silent! normal g'\"zO"
          \ | endif

    " No automatic comment continuation on new lines
    autocmd FileType * setlocal formatoptions-=c formatoptions-=r formatoptions-=o
  augroup END

  " ─── plugin settings (only once plugins are installed) ─────────────────

  if isdirectory(expand("~/.vim/plugged"))

    " Theme
    silent! colorscheme catppuccin_mocha
    set cursorline
    set termguicolors

    " Statusline
    let g:lightline = {'colorscheme': 'catppuccin_mocha'}
    let g:lightline.separator = { 'left': '', 'right': '' }
    set laststatus=2
    set noshowmode

  endif

endif
