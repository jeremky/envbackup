# ─── .zsh_aliases ────────────────────────────────────────────────────────

# shellcheck disable=all

# variables
export XDG_CONFIG_HOME="$HOME/.config"
export PATH="$HOME/.local/bin:$PATH"
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export EDITOR=vim
export LESSHISTFILE=/dev/null

# homebrew
if command -v brew &>/dev/null; then
  export HOMEBREW_NO_ENV_HINTS=1
  export HOMEBREW_NO_ANALYTICS=1
  export HOMEBREW_NO_ASK=1
  alias upgrade='brew update && brew upgrade -g && brew cleanup'
fi

# ─── aliases ─────────────────────────────────────────────────────────────

alias l='ls -lh'                                      # Detailed list
alias la='ls -lhA'                                    # List including hidden files
alias lr='ls -lLhR'                                   # Recursive list
alias lra='ls -lhRA'                                  # Recursive list including hidden files
alias lrt='ls -lLhrt'                                 # List by date
alias lrta='ls -lLhrtA'                               # List by date including hidden files
alias grep='grep -i --color=auto'                     # Case-insensitive grep
alias zgrep='zgrep -i --color=auto'                   # Grep in compressed files
alias psp='ps -eaf | grep -v grep | grep'             # Search for a process (psp <name>)
alias genkey='ssh-keygen -t ed25519 -a 100'           # Generate an ed25519 key
alias pubip='curl -s -4 ipecho.net/plain ; echo'      # Show public IP address
alias df='df -PlH'                                    # df without irrelevant mounts
alias rmds='find . -name ".DS_Store" -type f -delete' # Recursively delete .DS_Store files
alias rmdot="find . -name '._*' -type f -delete"      # Recursively delete ._ files
alias top='top -o cpu -U $(whoami)'                   # top filtered to the current user
alias vi='vim -O'                                     # vim with multiple files side by side
alias speedtest='networkQuality'                      # Apple speed test
alias locate='mdfind -name'                           # Search via Spotlight
alias hide='chflags hidden'                           # Hide folder in Finder
alias unhide='chflags nohidden'                       # Unhide folder in Finder

# ─── optional applications ───────────────────────────────────────────────

# btop / htop: enhanced top
if command -v btop &>/dev/null; then
  alias top='btop'
elif command -v htop &>/dev/null; then
  alias top='htop'
fi

# colordiff: diff with color
command -v colordiff &>/dev/null && alias diff='colordiff'

# duf: show filesystems
command -v duf &>/dev/null && alias df='duf -hide special'

# dust: enhanced du
command -v dust &>/dev/null && alias du='dust -rb'

# fzf: fuzzy finder with Catppuccin Mocha theme
if command -v fzf &>/dev/null; then
  source <(fzf --zsh)
  if command -v fd &>/dev/null; then
    export FZF_DEFAULT_COMMAND='fd'
  fi
  export FZF_DEFAULT_OPTS=" \
    --color=bg+:#313244,bg:#1E1E2E,spinner:#F5E0DC,hl:#F38BA8 \
    --color=fg:#CDD6F4,header:#F38BA8,info:#CBA6F7,pointer:#F5E0DC \
    --color=marker:#B4BEFE,fg+:#CDD6F4,prompt:#CBA6F7,hl+:#F38BA8 \
    --color=selected-bg:#45475A \
    --color=border:#6C7086,label:#CDD6F4"
fi

# herdr: terminal multiplexer
if command -v herdr &>/dev/null; then
  alias hr='herdr'
  alias hrstop='herdr session stop default'
fi

# icdiff: enhanced diff
command -v icdiff &>/dev/null && alias diff='icdiff'

# ncdu: TreeSize equivalent
command -v ncdu &>/dev/null && alias ncdu='ncdu --color dark'

# procs: enhanced ps
command -v procs &>/dev/null && alias psp='procs'

# rg: faster than grep
command -v rg &>/dev/null && alias rg='rg -i'

# zed: code editor
command -v zed &>/dev/null && alias e='zed'

# zoxide: enhanced cd
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"

# ─── functions ───────────────────────────────────────────────────────────

# cpsave: copy a file or directory with a .old suffix
cpsave() { cp -Rp "$1" "${1%/}.old"; }

# tarc: create an archive for each given file/directory
tarc() { for file in "$@"; do tar czvf "${file%/}.tar.gz" "$file"; done; }

# tarx: extract an archive
tarx() { for file in "$@"; do tar xzvf "$file"; done; }

# zipd: create one zip archive per file
zipd() { for file in "$@"; do /usr/bin/zip -r "${file%/}.zip" "$file"; done; }

# convweb: convert png files to webp
convweb() { for file in "$@"; do cwebp -q 100 "$file" -o "${file%.*}.webp" && rm -- "$file"; done; }

# netinfo: show network information
netinfo() { for service in "Ethernet" "Wi-Fi"; do
  echo "==> $service"
  networksetup -getinfo "$service"
  echo
done; }

# jback: local backup to an external drive
jback() { rsync -ah --no-perms --progress --exclude "._*" --exclude ".DS_Store" ~/Documents/ /Volumes/jdisk/Documents/; }

# ─── scripts ─────────────────────────────────────────────────────────────

# Turn scripts into aliases
scripts=~/Documents/scripts
if [[ -d $scripts ]]; then
  for i in envbackup ggit; do
    [[ -f $scripts/$i/$i.sh ]] && alias $i="$scripts/$i/$i.sh"
  done
fi

# hugo
sitedir=~/Documents/website
[[ -f $sitedir/hugo.sh ]] && alias hugo="$sitedir/hugo.sh"
